# Copy this file to .env and fill in your values. .env is gitignored.

# OpenAI (or compatible) credentials for the Pydantic AI agents.
OPENAI_API_KEY=your_key_here

# Optional: override the API base URL for a compatible provider.
# OPENAI_BASE_URL=

# Model identifier. The system is model agnostic; use the provider:model form.
# gpt-4.1 was selected by the model comparison experiment (see the decision log).
TRIAGE_MODEL=openai-chat:gpt-4.1

# Set to 1 to enable the optional LLM judge in the eval suite (otherwise it runs
# offline by default).
EVAL_LLM_JUDGE=
